{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempus",
  "version": "0.1.0",
  "identifier": "com.xiaofangstudio.tempus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1429",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tempus",
        "width": 1560,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "小方工作室",
    "icon": ["icons/icon.ico"],
    "copyright": "© 2026 小方工作室",
    "resources": ["ffmpeg/*", "skills/*"],
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      }
    }
  }
}
